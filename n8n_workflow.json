[
  {
    "name": "AUV - Send Annotation Emails",
    "active": false,
    "settings": { "executionOrder": "v1" },
    "nodes": [
      {
        "id": "a1b2c3d4-0001-0001-0001-000000000001",
        "name": "Receive Pipeline Trigger",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [240, 300],
        "parameters": {
          "path": "auv-pipeline-send",
          "responseMode": "responseNode",
          "options": {}
        }
      },
      {
        "id": "a1b2c3d4-0001-0001-0001-000000000002",
        "name": "Store Context",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [460, 300],
        "parameters": {
          "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst body = $input.first().json;\nstaticData.callbackUrl = body.callback_url;\nstaticData.expected    = body.expected;\nstaticData.saveDir     = body.save_dir || '/tmp/auv_replies';\nstaticData.received    = 0;\nreturn body.annotators.map(a => ({ json: { ...a, classes: body.classes.join(', ') } }));"
        }
      },
      {
        "id": "a1b2c3d4-0001-0001-0001-000000000003",
        "name": "Loop Annotators",
        "type": "n8n-nodes-base.splitInBatches",
        "typeVersion": 3,
        "position": [680, 300],
        "parameters": {
          "batchSize": 1,
          "options": {}
        }
      },
      {
        "id": "a1b2c3d4-0001-0001-0001-000000000004",
        "name": "Read Zip File",
        "type": "n8n-nodes-base.readWriteFile",
        "typeVersion": 1,
        "position": [900, 300],
        "parameters": {
          "operation": "read",
          "fileSelector": "={{ $json.zip_path }}",
          "options": {}
        }
      },
      {
        "id": "a1b2c3d4-0001-0001-0001-000000000005",
        "name": "Send Gmail",
        "type": "n8n-nodes-base.gmail",
        "typeVersion": 2,
        "position": [1120, 300],
        "parameters": {
          "sendTo": "={{ $json.email }}",
          "subject": "={{ '[AUV Annotation] Part ' + $json.part_num + ' — please annotate and reply with zip' }}",
          "emailType": "text",
          "message": "={{ 'Hi ' + $json.name + ',\\n\\nPlease annotate Part ' + $json.part_num + ' using CVAT.\\n\\nClasses: ' + $json.classes + '\\n\\nSteps:\\n1. Create CVAT task → upload attached zip\\n2. Annotate all frames\\n3. Export as YOLO 1.1 format\\n4. Reply to this email with exported zip attached\\n\\nThanks!' }}",
          "options": {
            "attachmentsUi": {
              "attachmentsBinary": [{}]
            }
          }
        },
        "credentials": {
          "gmailOAuth2": {
            "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
            "name": "Gmail account"
          }
        }
      },
      {
        "id": "a1b2c3d4-0001-0001-0001-000000000006",
        "name": "Respond OK",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [1340, 300],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify({ status: 'emails_sent', count: $input.all().length }) }}"
        }
      }
    ],
    "connections": {
      "Receive Pipeline Trigger": {
        "main": [[{ "node": "Store Context",   "type": "main", "index": 0 }]]
      },
      "Store Context": {
        "main": [[{ "node": "Loop Annotators", "type": "main", "index": 0 }]]
      },
      "Loop Annotators": {
        "main": [
          [{ "node": "Read Zip File",  "type": "main", "index": 0 }],
          [{ "node": "Respond OK",     "type": "main", "index": 0 }]
        ]
      },
      "Read Zip File": {
        "main": [[{ "node": "Send Gmail",      "type": "main", "index": 0 }]]
      },
      "Send Gmail": {
        "main": [[{ "node": "Loop Annotators", "type": "main", "index": 0 }]]
      }
    }
  },
  {
    "name": "AUV - Receive Annotation Replies",
    "active": false,
    "settings": { "executionOrder": "v1" },
    "nodes": [
      {
        "id": "b2c3d4e5-0002-0002-0002-000000000001",
        "name": "Gmail Trigger",
        "type": "n8n-nodes-base.gmailTrigger",
        "typeVersion": 1,
        "position": [240, 300],
        "parameters": {
          "pollTimes": { "item": [{ "mode": "everyMinute" }] },
          "simple": false,
          "filters": { "hasAttachment": true },
          "options": {}
        },
        "credentials": {
          "gmailOAuth2": {
            "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
            "name": "Gmail account"
          }
        }
      },
      {
        "id": "b2c3d4e5-0002-0002-0002-000000000002",
        "name": "Filter Zip Attachments",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [460, 300],
        "parameters": {
          "jsCode": "const msg = $input.first().json;\nconst attachments = msg.attachments || [];\nconst zips = attachments.filter(a => (a.filename || '').toLowerCase().endsWith('.zip'));\nif (zips.length === 0) return [];\nreturn [{ json: { from: msg.from?.value?.[0]?.address || 'unknown', filename: zips[0].filename, content: zips[0].content } }];"
        }
      },
      {
        "id": "b2c3d4e5-0002-0002-0002-000000000003",
        "name": "Save Zip to Disk",
        "type": "n8n-nodes-base.readWriteFile",
        "typeVersion": 1,
        "position": [680, 300],
        "parameters": {
          "operation": "write",
          "fileName": "={{ $getWorkflowStaticData('global').saveDir + '/annotated_' + $json.from.split('@')[0] + '.zip' }}",
          "options": {}
        }
      },
      {
        "id": "b2c3d4e5-0002-0002-0002-000000000004",
        "name": "Check If All Received",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [900, 300],
        "parameters": {
          "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.received = (staticData.received || 0) + 1;\nconst item = $input.first().json;\nconst savedPath = (staticData.saveDir || '/tmp/auv_replies') + '/annotated_' + item.from.split('@')[0] + '.zip';\nif (!staticData.savedPaths) staticData.savedPaths = [];\nstaticData.savedPaths.push(savedPath);\nreturn [{ json: { received: staticData.received, expected: staticData.expected || 0, callbackUrl: staticData.callbackUrl, savedPaths: staticData.savedPaths, from: item.from, filename: item.filename, allDone: staticData.received >= (staticData.expected || 1) } }];"
        }
      },
      {
        "id": "b2c3d4e5-0002-0002-0002-000000000005",
        "name": "All Received?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [1120, 300],
        "parameters": {
          "conditions": {
            "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
            "conditions": [
              {
                "id": "cond-001",
                "leftValue": "={{ $json.allDone }}",
                "rightValue": true,
                "operator": { "type": "boolean", "operation": "equals" }
              }
            ],
            "combinator": "and"
          }
        }
      },
      {
        "id": "b2c3d4e5-0002-0002-0002-000000000006",
        "name": "Notify Pipeline",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [1340, 220],
        "parameters": {
          "method": "POST",
          "url": "={{ $json.callbackUrl }}",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ email: $json.from, filename: $json.filename, zip_base64: Buffer.from(require('fs').readFileSync($json.savedPaths[$json.savedPaths.length - 1])).toString('base64'), status: 'all_complete', received: $json.received }) }}",
          "options": {}
        }
      },
      {
        "id": "b2c3d4e5-0002-0002-0002-000000000007",
        "name": "Partial — Log Only",
        "type": "n8n-nodes-base.noOp",
        "typeVersion": 1,
        "position": [1340, 400],
        "parameters": {}
      }
    ],
    "connections": {
      "Gmail Trigger": {
        "main": [[{ "node": "Filter Zip Attachments", "type": "main", "index": 0 }]]
      },
      "Filter Zip Attachments": {
        "main": [[{ "node": "Save Zip to Disk",       "type": "main", "index": 0 }]]
      },
      "Save Zip to Disk": {
        "main": [[{ "node": "Check If All Received",  "type": "main", "index": 0 }]]
      },
      "Check If All Received": {
        "main": [[{ "node": "All Received?",           "type": "main", "index": 0 }]]
      },
      "All Received?": {
        "main": [
          [{ "node": "Notify Pipeline",  "type": "main", "index": 0 }],
          [{ "node": "Partial — Log Only", "type": "main", "index": 0 }]
        ]
      }
    }
  }
]
